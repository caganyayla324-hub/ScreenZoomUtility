<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScreenZoomUtility</AssemblyName>
    <RootNamespace>ScreenZoomUtility</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Advanced Windows Screen Zoom &amp; Keyboard Utility</Product>
    <Description>Standalone Windows accessibility and productivity utility for full-screen magnification and keyboard sequences.</Description>
  </PropertyGroup>

</Project>
