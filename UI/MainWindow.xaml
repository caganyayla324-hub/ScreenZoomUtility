<Window x:Class="ScreenZoomUtility.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Screen Zoom &amp; Keyboard Utility"
        Width="1120" Height="740"
        MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
                    <TextBlock Text="ZOOM &amp; KEYBOARD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Desktop Utility" FontSize="20" FontWeight="Bold" Margin="0,2,0,0" />
                    <TextBlock Text="Accessibility &amp; Productivity" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Emergency Stop Box -->
                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" Background="#26161A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="SAFETY CONTROL" FontSize="10.5" FontWeight="Bold" Foreground="#FCA5A5" />
                        <TextBlock x:Name="EmergencyShortcutText" Text="Shortcut: Ctrl + Alt + Esc" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8" />
                        <Button Content="EMERGENCY STOP ALL" Style="{StaticResource DangerButtonStyle}" Click="OnEmergencyStopClick" />
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Margin="0,4,0,0">
                    <RadioButton x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="OnNavChecked" Tag="Dashboard" />
                    <RadioButton x:Name="NavZoom" Content="Screen Zoom" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="Zoom" />
                    <RadioButton x:Name="NavKeyboard" Content="Keyboard Utility" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="Keyboard" />
                    <RadioButton x:Name="NavHotkeys" Content="Hotkey Manager" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="Hotkeys" />
                    <RadioButton x:Name="NavProfiles" Content="Profiles" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="Profiles" />
                    <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="Settings" />
                    <RadioButton x:Name="NavAbout" Content="About" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="About" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <DockPanel Grid.Column="1">
            <!-- Top Status Bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="Dashboard" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border x:Name="ActiveSequenceBadge" Visibility="Collapsed" Margin="14,0,0,0" Padding="10,4" CornerRadius="12" Background="#78350F" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                            <TextBlock x:Name="ActiveSequenceText" Text="SEQUENCE RUNNING" FontSize="11.5" FontWeight="SemiBold" Foreground="#FDE68A" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="10,5" CornerRadius="6" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock x:Name="TopProfileBadge" Text="Profile: Default" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border Padding="10,5" CornerRadius="6" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <TextBlock x:Name="TopZoomBadge" Text="Zoom: 1.0x" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Host -->
            <ContentControl x:Name="MainContentHost" Margin="22,18,22,18" />
        </DockPanel>
    </Grid>
</Window>
