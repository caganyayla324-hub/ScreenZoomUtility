<UserControl x:Class="ScreenZoomUtility.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Advanced Windows Screen Zoom &amp; Keyboard Utility" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Version 1.0.0 • .NET 10 WPF Desktop Application" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,12" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20"
                               Text="A standalone, general-purpose Windows accessibility and productivity desktop utility consisting of two independent modules: a Full-Screen Desktop Magnification Engine and a General-Purpose Keyboard Shortcut &amp; Sequence Engine." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Documented Windows APIs Used" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="• Windows Magnification API (Magnification.dll) — desktop-level full-screen scaling" Margin="0,2" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="• User32 RegisterHotKey / WM_HOTKEY — OS-managed global shortcuts" Margin="0,2" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="• User32 SendInput — standard user-mode keyboard sequence playback" Margin="0,2" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="• System.Text.Json — local human-readable configuration &amp; profile storage" Margin="0,2" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Security, Independence &amp; Compliance" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20"
                               Text="This utility is completely independent of all third-party applications and games. It never inspects or modifies external process memory, never injects DLLs or hooks into rendering pipelines, never installs kernel drivers, and never conceals its activity. Always ensure your use of desktop automation complies with the terms of service of any software you run." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
