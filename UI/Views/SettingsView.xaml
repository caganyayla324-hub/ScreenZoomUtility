<UserControl x:Class="ScreenZoomUtility.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Safety Controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Safety &amp; Execution Limits" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max Sequence Duration (ms):" VerticalAlignment="Center" />
                        <TextBox x:Name="MaxDurationBox" Grid.Column="1" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Min Step Delay (ms):" VerticalAlignment="Center" />
                        <TextBox x:Name="MinDelayBox" Grid.Column="1" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max Step Delay (ms):" VerticalAlignment="Center" />
                        <TextBox x:Name="MaxDelayBox" Grid.Column="1" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Execution Cooldown (ms):" VerticalAlignment="Center" />
                        <TextBox x:Name="CooldownBox" Grid.Column="1" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max Zoom Multiplier (x):" VerticalAlignment="Center" />
                        <TextBox x:Name="MaxZoomBox" Grid.Column="1" />
                    </Grid>

                    <CheckBox x:Name="KeyboardEnabledCheck" Content="Enable Keyboard Utility Module" Margin="0,4,0,6" />
                    <CheckBox x:Name="PreventSimultaneousCheck" Content="Prevent simultaneous sequence execution" Margin="0,4,0,6" />
                    <CheckBox x:Name="ShowIndicatorCheck" Content="Show visible active-sequence banner in header" Margin="0,4,0,6" />
                    <CheckBox x:Name="ConfirmExitCheck" Content="Ask for confirmation before closing application" Margin="0,4,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="OnSaveClick" />
                        <TextBlock x:Name="SaveFeedbackText" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Storage & Maintenance -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Configuration Storage (JSON)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="ConfigPathText" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="Open Config Folder" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnOpenFolderClick" />
                        <Button Content="Reset All Settings to Defaults" Style="{StaticResource DangerButtonStyle}" Click="OnResetAllClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
