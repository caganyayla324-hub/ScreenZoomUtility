<UserControl x:Class="ScreenZoomUtility.UI.Views.ScreenZoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Status & Live Controls -->
            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Activate" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="OnActivateClick" />
                        <Button Content="Deactivate" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnDeactivateClick" />
                        <Button Content="Reset 1.0x" Style="{StaticResource DangerButtonStyle}" Click="OnResetClick" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Full-Screen Desktop Magnification" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="LiveStatusText" Text="Idle (1.0x)" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Zoom Multipliers -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Zoom Level Presets" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <WrapPanel x:Name="PresetButtonsPanel" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Custom Multiplier (x):" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="CustomZoomBox" Grid.Column="1" Text="2.0" />
                        <Button Grid.Column="2" Content="Apply Custom" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Click="OnApplyCustomClick" />
                        <TextBlock x:Name="CustomValidationText" Grid.Column="3" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Positioning & Tracking -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Positioning &amp; Tracking" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Positioning Mode:" VerticalAlignment="Center" />
                        <ComboBox x:Name="PositionModeCombo" Grid.Column="1" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="Mouse Cursor Tracking" Tag="CursorTracking" />
                            <ComboBoxItem Content="Screen Center" Tag="ScreenCenter" />
                            <ComboBoxItem Content="Manual Coordinates" Tag="ManualCoordinates" />
                        </ComboBox>
                    </Grid>

                    <StackPanel x:Name="ManualCoordsPanel" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Manual X:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="ManualXBox" Width="90" Margin="0,0,18,0" />
                        <TextBlock Text="Manual Y:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="ManualYBox" Width="90" Margin="0,0,12,0" />
                        <Button Content="Apply Coordinates" Style="{StaticResource SecondaryButtonStyle}" Click="OnApplyCoordsClick" />
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Smoothing Factor:" VerticalAlignment="Center" />
                        <Slider x:Name="SmoothingSlider" Grid.Column="1" Minimum="0.08" Maximum="0.85" TickFrequency="0.05" ValueChanged="OnSmoothingChanged" />
                        <TextBlock x:Name="SmoothingValueText" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Text="0.25" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Scaling Quality Mode:" VerticalAlignment="Center" />
                        <ComboBox x:Name="QualityCombo" Grid.Column="1" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="High Quality (Smooth)" Tag="HighQuality" />
                            <ComboBoxItem Content="Balanced" Tag="Balanced" />
                            <ComboBoxItem Content="Low Latency" Tag="LowLatency" />
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="ClampEdgesCheck" Content="Prevent screen-edge clipping (clamp magnified viewport to display bounds)" Margin="0,6,0,6" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    <CheckBox x:Name="ZoomEnabledCheck" Content="Enable Screen Zoom Module" Margin="0,4,0,0" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
