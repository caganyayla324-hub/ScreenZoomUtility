<UserControl x:Class="ScreenZoomUtility.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Top Metric Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ZOOM ENGINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="ZoomStatusText" Text="Idle" FontSize="22" FontWeight="Bold" Margin="0,6,0,2" />
                        <TextBlock x:Name="ZoomMultiplierText" Text="1.0x • Cursor Tracking" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="KEYBOARD ENGINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="KeyboardStatusText" Text="Enabled" FontSize="22" FontWeight="Bold" Margin="0,6,0,2" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock x:Name="SequenceCountText" Text="0 sequences configured" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE PROFILE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="ActiveProfileText" Text="Default" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,8,0,2" />
                        <TextBlock x:Name="ProfileHintText" Text="Switch via Hotkey or Profiles" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="CpuText" Text="CPU: 0.0%" FontSize="18" FontWeight="Bold" Margin="0,8,0,2" />
                        <TextBlock x:Name="MemoryText" Text="RAM: 0.0 MB" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick Controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Quick Controls" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="Toggle Zoom" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8" Click="OnToggleZoomClick" />
                        <Button Content="Zoom +0.5x" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,8" Click="OnIncreaseZoomClick" />
                        <Button Content="Zoom -0.5x" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,8" Click="OnDecreaseZoomClick" />
                        <Button Content="Reset 1.0x" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,8" Click="OnResetZoomClick" />
                        <Button Content="Emergency Stop All" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,8" Click="OnEmergencyStopClick" />
                    </WrapPanel>
                    <TextBlock x:Name="StatusDetailText" Text="Ready" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Assigned Shortcuts Summary -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Assigned Global Shortcuts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl x:Name="ShortcutsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ActionName}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="8,3" CornerRadius="5" Background="{StaticResource BgPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding FormattedShortcut}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
