<UserControl x:Class="ScreenZoomUtility.UI.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Profile List -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Saved Profiles" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="+ New" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6" Margin="0,0,6,6" Click="OnNewProfileClick" />
                        <Button Content="Duplicate" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,6,6" Click="OnDuplicateProfileClick" />
                        <Button Content="Delete" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,0,6" Click="OnDeleteProfileClick" />
                    </WrapPanel>
                </StackPanel>

                <ListBox x:Name="ProfilesList" SelectionChanged="OnProfileSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Profile Details -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
            <StackPanel>
                <TextBlock Text="Profile Details" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                <TextBlock Text="Profile Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="ProfileNameBox" Margin="0,4,0,12" />

                <TextBlock Text="Description" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="ProfileDescBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,4,0,14" />

                <TextBlock x:Name="ProfileStatsText" Foreground="{StaticResource AccentBrush}" FontSize="12.5" Margin="0,0,0,16" />

                <WrapPanel>
                    <Button Content="Activate Profile" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="OnActivateProfileClick" />
                    <Button Content="Save Changes" Style="{StaticResource SecondaryButtonStyle}" Click="OnSaveProfileClick" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
