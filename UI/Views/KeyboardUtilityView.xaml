<UserControl x:Class="ScreenZoomUtility.UI.Views.KeyboardUtilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Sequence List -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Saved Sequences" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="+ New" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,6" Padding="10,6" Click="OnNewSequenceClick" />
                        <Button Content="Duplicate" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="10,6" Click="OnDuplicateSequenceClick" />
                        <Button Content="Delete" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" Padding="10,6" Click="OnDeleteSequenceClick" />
                    </WrapPanel>
                </StackPanel>

                <ListBox x:Name="SequencesList" SelectionChanged="OnSequenceSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: Visual Sequence Editor & Log -->
        <DockPanel Grid.Column="2">
            <!-- Execution Log -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Height="130">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Click="OnClearLogClick" />
                        <TextBlock Text="Execution Log &amp; Safety Feedback" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="ExecutionLogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Top" />
                </DockPanel>
            </Border>

            <!-- Editor Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditorPanel">
                        <!-- Sequence Header -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sequence Name" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox x:Name="SequenceNameBox" Margin="0,4,12,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Save" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnSaveSequenceClick" />
                                <Button Content="Run Sequence" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="OnRunSequenceClick" />
                                <Button Content="Stop" Style="{StaticResource DangerButtonStyle}" Click="OnStopSequenceClick" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TimelineSummaryText" Text="Total Duration: 0 ms" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                        <!-- Steps List -->
                        <TextBlock Text="Execution Steps (in order)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="StepsList" Height="155" SelectionChanged="OnStepSelected" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ShortcutSummary}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding DelayAfterMs, StringFormat='Delay after: {0} ms'}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="+ Add Step" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="10,6" Click="OnAddStepClick" />
                            <Button Content="Move Up" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="10,6" Click="OnMoveUpClick" />
                            <Button Content="Move Down" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="10,6" Click="OnMoveDownClick" />
                            <Button Content="Remove Step" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Click="OnRemoveStepClick" />
                        </WrapPanel>

                        <!-- Selected Step Editor -->
                        <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Edit Selected Step" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Step Label" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox x:Name="StepLabelBox" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Press Key to Capture" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox x:Name="StepKeyCaptureBox" Margin="0,4,0,0" IsReadOnly="True" PreviewKeyDown="OnStepKeyCapture" Text="Click &amp; press key" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                    <CheckBox x:Name="StepCtrlCheck" Content="Ctrl" Margin="0,0,16,0" />
                                    <CheckBox x:Name="StepAltCheck" Content="Alt" Margin="0,0,16,0" />
                                    <CheckBox x:Name="StepShiftCheck" Content="Shift" Margin="0,0,16,0" />
                                    <CheckBox x:Name="StepWinCheck" Content="Win" Margin="0,0,16,0" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay (ms):" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="StepDelayBox" Grid.Column="1" Text="100" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Content="50ms" Style="{StaticResource SecondaryButtonStyle}" Padding="7,4" FontSize="11" Margin="0,0,4,0" Click="OnPresetDelayClick" Tag="50" />
                                        <Button Content="100ms" Style="{StaticResource SecondaryButtonStyle}" Padding="7,4" FontSize="11" Margin="0,0,4,0" Click="OnPresetDelayClick" Tag="100" />
                                        <Button Content="250ms" Style="{StaticResource SecondaryButtonStyle}" Padding="7,4" FontSize="11" Margin="0,0,4,0" Click="OnPresetDelayClick" Tag="250" />
                                        <Button Content="500ms" Style="{StaticResource SecondaryButtonStyle}" Padding="7,4" FontSize="11" Margin="0,0,4,0" Click="OnPresetDelayClick" Tag="500" />
                                        <Button Content="1000ms" Style="{StaticResource SecondaryButtonStyle}" Padding="7,4" FontSize="11" Click="OnPresetDelayClick" Tag="1000" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="Apply Step" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Click="OnApplyStepClick" />
                                </Grid>

                                <TextBlock x:Name="StepErrorText" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
